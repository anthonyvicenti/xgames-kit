      {
        "id": "mechanic.race.ring-radius",
        "label": "Ring course radius",
        "group": "mechanics",
        "type": "number",
        "source": {
          "pointer": "{base}/ringRadius"
        },
        "tier": "advanced",
        "facet": "gameplay",
        "constraints": {
          "min": 0,
          "max": 100,
          "unit": "m"
        }
      },
      {
        "id": "mechanic.race.place-points",
        "label": "Score for each place",
        "group": "mechanics",
        "type": "json",
        "source": {
          "pointer": "{base}/placePoints"
        },
        "tier": "advanced",
        "facet": "gameplay"
      },
      {
        "id": "mechanic.race.lap-text",
        "label": "Lap line",
        "group": "mechanics",
        "type": "text",
        "source": {
          "pointer": "{base}/lapText"
        },
        "tier": "advanced",
        "facet": "text",
        "constraints": {
          "maxLength": 40
        }
      },
      {
        "id": "mechanic.race.prop",
        "label": "Gate prop",
        "group": "mechanics",
        "type": "text",
        "source": {
          "pointer": "{base}/prop"
        },
        "tier": "advanced",
        "facet": "text",
        "constraints": {
          "maxLength": 40
        }
      },
      {
        "id": "mechanic.race.sound-checkpoint",
        "label": "Gate sound id",
        "group": "mechanics",
        "type": "text",
        "source": {
          "pointer": "{base}/soundCheckpoint"
        },
        "tier": "advanced",
        "facet": "text",
        "constraints": {
          "maxLength": 40
        }
      },
      {
        "id": "mechanic.race.sound-lap",
        "label": "Lap sound id",
        "group": "mechanics",
        "type": "text",
        "source": {
          "pointer": "{base}/soundLap"
        },
        "tier": "advanced",
        "facet": "text",
        "constraints": {
          "maxLength": 40
        }
      }
    ]
  },
  "events": [
    {
      "name": "onCheckpoint",
      "on": "host",
      "args": "{ player, index }",
      "when": "a player passed a gate"
    },
    {
      "name": "onLap",
      "on": "host",
      "args": "{ player, lap }",
      "when": "a player finished a lap"
    },
    {
      "name": "onFinish",
      "on": "host",
      "args": "{ player, place, points }",
      "when": "a player finished the race"
    }
  ],
  "host": {
    "owner": "host",
    "how": "the host judges every crossing and the finish order",
    "state": "race",
    "fields": {
      "r": "{ playerId: [lap, checkpoint, place] }",
      "o": "the finish order (player ids)"
    }
  },
  "owns": [],
  "needs": {
    "mechanics": [],
    "worlds": []
  },
  "uses": [],
  "gives": [
    "checkpoints"
  ],
  "objectives": {
    "props": [
      {
        "param": "prop"
      }
    ]
  },
  "bots": "the rules steer bots with race.botStep(p) in rules.bot",
  "notes": {
    "lines": [
      "The gates are drawn and judged by the kit: params.checkpoints is [[x, z], …], or leave it empty for a ring of ringCount gates.",
      "The race ends the round only when rules.check returns race.check(); a finish already scores placePoints.",
      "race.standings() and race.progress(p) are the same on every copy."
    ],
    "readme": "components/race/README.md",
    "stub": {
      "as": "race",
      "worked": "check(ctx) { return race.check(); }   // null, or { winners: [first to finish], reason: 'finished' }",
      "traps": [
        "bots stand still unless the rules steer them: in bot(ctx, p) call race.botStep(p)",
        "adding score in onFinish counts a place twice (placePoints is already added)"
      ]
    }
  },
  "signs": "checked: gate C (measure 15) judges its sign of life (sample and judge in the implementation)",
