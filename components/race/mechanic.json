{
  "id": "race",
  "name": "Race",
  "describe": "Checkpoints, laps, a finish order",
  "examples": [
    "three laps around the yard",
    "checkpoint dash",
    "obstacle course to the flag"
  ],
  "rank": 80,
  "params": {
    "type": "object",
    "additionalProperties": true,
    "properties": {
      "checkpoints": {
        "type": "array",
        "default": [],
        "items": {
          "type": "array"
        },
        "description": "The course: [[x, z], ...] in order, or [] for a ring of ringCount gates"
      },
      "ringCount": {
        "type": "integer",
        "minimum": 2,
        "maximum": 24,
        "default": 6,
        "description": "Gates in the automatic ring course"
      },
      "ringRadius": {
        "type": "number",
        "description": "Radius of the ring course in metres (0: 60% of the play area)",
        "minimum": 0,
        "maximum": 100,
        "default": 0
      },
      "laps": {
        "type": "integer",
        "minimum": 1,
        "maximum": 20,
        "default": 3,
        "description": "Laps to finish"
      },
      "radius": {
        "type": "number",
        "description": "How close counts as passing a gate (m)",
        "minimum": 0.5,
        "maximum": 10,
        "default": 2.4
      },
      "color": {
        "type": "string",
        "default": "#ffd23f",
        "description": "Gate colour"
      },
      "nextColor": {
        "type": "string",
        "default": "#4be0a8",
        "description": "Colour of the gate you are heading for"
      },
      "gateSize": {
        "type": "number",
        "description": "Gate ring diameter in metres",
        "minimum": 0.5,
        "maximum": 8,
        "default": 2.6
      },
      "prop": {
        "type": "string",
        "default": "",
        "description": "Prop slot to stand at each gate instead of the ring (\"\": a ring)"
      },
      "placePoints": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "default": [
          3,
          2,
          1
        ],
        "description": "Score for finishing 1st, 2nd, ..."
      },
      "ending": {
        "type": "string",
        "enum": [
          "first",
          "all",
          "never"
        ],
        "default": "first",
        "description": "What check() waits for: the first finisher, everyone, or nothing (time decides)"
      },
      "toast": {
        "type": "boolean",
        "default": true,
        "description": "Show a line when you finish a lap"
      },
      "lapText": {
        "type": "string",
        "default": "Lap {lap}/{laps}",
        "description": "That line; {lap} and {laps}"
      },
      "soundCheckpoint": {
        "type": "string",
        "default": "coin",
        "description": "Sound id at a gate"
      },
      "soundLap": {
        "type": "string",
        "default": "win",
        "description": "Sound id at the end of a lap"
      }
    }
  },
  "slots": {
    "templates": [
      {
        "id": "mechanic.race.laps",
        "label": "Laps",
        "group": "mechanics",
        "type": "integer",
        "source": {
          "pointer": "{base}/laps"
        },
        "tier": "main",
        "facet": "gameplay",
        "rank": 56,
        "constraints": {
          "min": 1,
          "max": 20
        }
      },
      {
        "id": "mechanic.race.color",
        "label": "Gate colour",
        "group": "mechanics",
        "type": "color",
        "source": {
          "pointer": "{base}/color"
        },
        "tier": "main",
        "facet": "look",
        "rank": 50
      },
      {
        "id": "mechanic.race.next-color",
        "label": "Next gate colour",
        "group": "mechanics",
        "type": "color",
        "source": {
          "pointer": "{base}/nextColor"
        },
        "tier": "advanced",
        "facet": "look",
        "rank": 44
