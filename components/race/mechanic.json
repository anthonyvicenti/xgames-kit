        "source": {
          "pointer": "{base}/ringCount"
        },
        "tier": "advanced",
        "facet": "gameplay",
        "rank": 40,
        "constraints": {
          "min": 2,
          "max": 24
        }
      },
      {
        "id": "mechanic.race.radius",
        "label": "Gate pass distance",
        "group": "mechanics",
        "type": "number",
        "source": {
          "pointer": "{base}/radius"
        },
        "tier": "advanced",
        "facet": "gameplay",
        "constraints": {
          "min": 0.5,
          "max": 10,
          "unit": "m"
        }
      },
      {
        "id": "mechanic.race.gate-size",
        "label": "Gate size",
        "group": "mechanics",
        "type": "number",
        "source": {
          "pointer": "{base}/gateSize"
        },
        "tier": "advanced",
        "facet": "gameplay",
        "constraints": {
          "min": 0.5,
          "max": 8,
          "unit": "m"
        }
