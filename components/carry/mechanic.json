      "why": "interact grabs an item in reach (params.grabAction)"
    },
    {
      "res": "input.<throwAction>",
      "when": "throwAction is set",
      "why": "a throw on its own key"
    },
    {
      "res": "player.control",
      "when": "grabPlayers is true",
      "why": "a carried player is held"
    }
