{
  "id": "carry",
  "name": "Carry",
  "describe": "Grab, carry and throw props or players",
  "examples": [
    "pick up and hold a ball",
    "carry crates and throw them",
    "grab a friend and toss them"
  ],
  "rank": 50,
  "params": {
    "type": "object",
    "additionalProperties": true,
    "properties": {
      "prop": {
        "type": "string",
        "default": "",
        "description": "Name of the prop.* slot to carry (\"\": the first gameplay prop of the game, else a coloured box)"
      },
      "count": {
        "type": "integer",
        "minimum": -1,
        "maximum": 60,
        "default": -1,
        "description": "Items placed at the start (-1: the game prop's count; 0: none, rules spawn them)"
      },
      "spawnZone": {
        "type": "string",
        "default": "",
        "description": "World zone to scatter the start items in (\"\": around the play area)"
      },
      "size": {
        "type": "number",
        "description": "Item size in metres (0: the game prop's size)",
        "minimum": 0,
        "maximum": 5,
        "default": 0
      },
      "color": {
        "type": "string",
        "default": "#ffc84a",
        "description": "Colour of the stand-in box"
      },
      "maxHeld": {
        "type": "integer",
        "minimum": 1,
        "maximum": 4,
        "default": 1,
        "description": "Items one player can hold"
      },
      "reach": {
        "type": "number",
        "description": "How close a player must be to grab (m)",
        "minimum": 0.5,
        "maximum": 6,
        "default": 1.8
      },
      "grabAction": {
        "type": "string",
        "enum": [
          "",
          "interact",
          "primary",
          "secondary"
        ],
        "default": "interact",
        "description": "Input that grabs (or drops when nothing is in reach); \"\": the rules call grab()"
      },
      "throwAction": {
        "type": "string",
        "enum": [
          "",
          "interact",
          "primary",
          "secondary"
        ],
        "default": "",
        "description": "Input that throws what you hold; \"\": the rules call throw()"
      },
      "throwSpeed": {
        "type": "number",
        "description": "Throw speed (m/s)",
        "minimum": 1,
        "maximum": 30,
        "default": 11
      },
      "throwArc": {
        "type": "number",
        "description": "Upward bias of a throw",
        "minimum": 0,
        "maximum": 2,
        "default": 0.45
      },
      "gravity": {
        "type": "number",
        "description": "Gravity on a thrown item",
        "minimum": 0,
        "maximum": 40,
        "default": 16
      },
      "bounciness": {
        "type": "number",
        "description": "Bounce kept on landing",
        "minimum": 0,
        "maximum": 0.95,
        "default": 0.45
      },
      "holdHeight": {
        "type": "number",
        "description": "Height (m) above the feet an item is held at when the body has no hand socket",
        "minimum": 0,
        "maximum": 3,
        "default": 1
      },
      "socket": {
        "type": "string",
        "enum": [
          "hand_r",
          "hand_l",
          "head",
          "back"
        ],
        "default": "hand_r",
        "description": "Character socket the item is held at"
      },
      "grabPlayers": {
        "type": "boolean",
        "default": false,
        "description": "Nothing in reach: grab the nearest friend instead (they are carried, then thrown)"
      },
      "maxItems": {
        "type": "integer",
        "minimum": 1,
        "maximum": 40,
        "default": 24,
        "description": "Items alive at once (each costs about 30 bytes of the world message)"
      },
      "soundGrab": {
        "type": "string",
        "default": "",
        "description": "Sound id when an item is picked up"
      },
      "soundThrow": {
        "type": "string",
        "default": "",
        "description": "Sound id when an item is thrown"
      }
    }
  },
