{
  "id": "boss",
  "name": "Boss",
  "describe": "A boss with phases and telegraphed attacks (slam, charge, volley, summon) and its health bar on the HUD",
  "examples": [
    "a giant skeleton king on the last island",
    "a boss with a slam, a charge and a volley",
    "a final guardian that calls minions"
  ],
  "rank": 130,
  "params": {
    "type": "object",
    "additionalProperties": true,
    "properties": {
      "name": {
        "type": "string",
        "default": "The Warden",
        "description": "The boss's name on its HUD bar"
      },
      "role": {
        "type": "string",
        "default": "boss",
        "description": "Character role whose body (character.body.<role>) draws it; else the waves enemy body, scaled; else a stand-in"
      },
      "height": {
        "type": "number",
        "description": "Height (m)",
        "minimum": 1,
        "maximum": 10,
        "default": 3.4
      },
      "radius": {
        "type": "number",
        "description": "Body radius for hits (m)",
        "minimum": 0.4,
        "maximum": 4,
        "default": 1
      },
      "hp": {
        "type": "number",
        "description": "Hit points (alone)",
        "minimum": 1,
        "maximum": 2000,
        "default": 60
      },
      "hpPerPlayer": {
        "type": "number",
        "description": "Extra hit points per player beyond the first (fraction)",
        "minimum": 0,
        "maximum": 3,
        "default": 0.6
      },
      "speed": {
        "type": "number",
        "description": "Walking speed (m/s)",
        "minimum": 0.3,
        "maximum": 10,
        "default": 2.5
      },
      "color": {
        "type": "string",
        "default": "#b8413a",
        "description": "Tint (and the stand-in's colour)"
      },
      "phases": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "default": [
          0.6,
          0.3
        ],
        "description": "Hit-point shares where it changes phase (0.6, 0.3: three phases)"
      },
      "attacks": {
        "type": "array",
        "default": [
          [
            "slam",
            "charge"
          ],
          [
            "slam",
            "volley",
            "charge",
            "summon"
          ],
          [
            "volley",
            "slam",
            "charge",
            "summon"
          ]
        ],
        "description": "Each phase's attacks in order: slam, charge, volley, summon"
      },
      "slam": {
        "type": "object",
        "additionalProperties": true,
        "default": {
          "windup": 1,
          "radius": 3.3,
          "ahead": 2,
          "damage": 2,
          "knock": 9,
          "recover": 0.9
        },
        "description": "{windup, radius, ahead, damage, knock, recover}"
      },
      "charge": {
        "type": "object",
        "additionalProperties": true,
        "default": {
          "windup": 0.95,
          "speed": 13,
          "length": 12,
          "width": 2.4,
          "damage": 2,
          "knock": 10,
          "recover": 1.3
        },
        "description": "{windup, speed, length, width, damage, knock, recover}"
      },
      "volley": {
        "type": "object",
        "additionalProperties": true,
        "default": {
          "windup": 0.85,
          "count": 7,
          "spread": 70,
          "speed": 7,
          "damage": 1,
          "recover": 0.7
        },
        "description": "{windup, count, spread (degrees), speed, damage, recover}"
      },
      "summon": {
        "type": "object",
        "additionalProperties": true,
        "default": {
          "windup": 1.1,
          "count": 3,
          "types": [],
          "recover": 0.9
        },
        "description": "{windup, count, types (the waves mechanic's type ids), recover}"
      },
      "cooldown": {
        "type": "number",
        "description": "Seconds between attacks",
        "minimum": 0.2,
        "maximum": 10,
        "default": 1.3
      },
      "phaseSpeed": {
        "type": "number",
        "description": "Speed gained each phase (fraction)",
        "minimum": 0,
        "maximum": 1,
        "default": 0.15
      },
      "phaseWindup": {
        "type": "number",
        "description": "Windup shortened each phase (fraction)",
        "minimum": 0,
        "maximum": 0.5,
        "default": 0.12
      },
      "maxMinions": {
        "type": "integer",
        "minimum": 0,
        "maximum": 16,
        "default": 4,
        "description": "No summon while this many enemies are up"
      },
      "introSeconds": {
        "type": "number",
        "description": "Seconds it stands before it fights",
        "minimum": 0,
        "maximum": 10,
        "default": 1.8
      },
      "roarSeconds": {
        "type": "number",
        "description": "Seconds it roars (and takes no hits) as a phase begins",
        "minimum": 0,
        "maximum": 5,
        "default": 1.4
      },
      "startDelay": {
        "type": "number",
        "description": "Without the levels mechanic: seconds into the round before it comes",
        "minimum": 0,
        "maximum": 600,
        "default": 3
      },
      "auto": {
        "type": [
          "string",
          "boolean"
        ],
        "enum": [
          "auto",
          true,
          false
        ],
        "default": "auto",
        "description": "auto: it comes by itself when the game has no levels mechanic"
      },
      "killPoints": {
        "type": "number",
        "description": "Score for the player who brings it down",
        "minimum": 0,
        "maximum": 10000,
        "default": 100
      },
      "weapon": {
        "type": "string",
        "default": "",
        "description": "A file in assets/models/ it holds on hand_r (slot mechanic.boss.weapon), e.g. a KayKit staff"
      },
      "weaponGrip": {
        "type": [
          "object",
          "null"
        ],
        "default": null,
        "description": "The weapon's place on the hand_r socket {position, quaternion} (research/gf-scenic/library/props.json)"
      },
      "barColor": {
        "type": "string",
        "default": "#ff5a4a"
      },
      "telegraphColor": {
        "type": "string",
        "default": "#ff3b2f"
      },
      "flashColor": {
        "type": "string",
        "default": "#ffffff"
      },
      "deathSeconds": {
        "type": "number",
        "description": "Seconds it takes to fall and sink away",
        "minimum": 1,
        "maximum": 8,
        "default": 3
      },
      "soundRoar": {
        "type": "string",
        "default": "boss-roar"
      },
      "soundSlam": {
        "type": "string",
        "default": "boss-slam"
      },
      "soundDown": {
        "type": "string",
        "default": "boss-down"
      },
      "soundWindup": {
        "type": "string",
        "default": "enemy-windup"
      }
    }
  },
