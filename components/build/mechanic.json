{
  "id": "build",
  "name": "Build",
  "describe": "Place, break and paint blocks in a shared voxel world; signs and boom blocks; saved on the play host",
  "examples": [
    "build houses with friends in a block world",
    "a sandbox island anyone can change",
    "paint and sign your builds"
  ],
  "params": {
    "type": "object",
    "additionalProperties": true,
    "properties": {
      "hotbar": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "maxItems": 20,
        "default": [],
        "description": "Block ids on the hotbar, in order (keys 1-9 and 0 pick the first ten). Empty: every block players may place"
      },
      "reach": {
        "type": "number",
        "description": "How far a player reaches, in blocks from their head",
        "minimum": 3,
        "maximum": 14,
        "default": 7
      },
      "rate": {
        "type": "number",
        "description": "Edits a player may make per second (the host refuses more)",
        "minimum": 1,
        "maximum": 30,
        "default": 8
      },
      "burst": {
        "type": "number",
        "description": "Edits a player may make at once before the rate applies",
        "minimum": 1,
        "maximum": 60,
        "default": 20
      },
      "paint": {
        "type": "boolean",
        "default": true,
        "description": "The paint tool"
      },
      "signs": {
        "type": "boolean",
        "default": true,
        "description": "Signs (the world needs a sign block: voxel.signBlock)"
      },
      "boomFuse": {
        "type": "number",
        "description": "Seconds from placing a boom block to its pop",
        "minimum": 0.5,
        "maximum": 10,
        "default": 3
      },
      "boomRadius": {
        "type": "number",
        "description": "Radius of a boom's crater, in blocks",
        "minimum": 1,
        "maximum": 5,
        "default": 2.6
      },
      "boomCooldown": {
        "type": "number",
        "description": "Seconds before the same player can place another boom block",
        "minimum": 0,
        "maximum": 120,
        "default": 10
      },
      "boomPush": {
        "type": "number",
        "description": "How hard a boom pushes players near it (m/s)",
        "minimum": 0,
        "maximum": 20,
        "default": 8
      },
      "boomChain": {
        "type": "boolean",
        "default": true,
        "description": "A boom inside a crater goes off at once"
      },
      "saveEvery": {
        "type": "number",
        "description": "Seconds between the host's saves to the play host",
        "minimum": 1,
        "maximum": 10,
        "default": 2
      },
      "pollEvery": {
        "type": "number",
        "description": "Seconds between the host's looks at the play host for other writers",
        "minimum": 5,
        "maximum": 120,
        "default": 15
      },
      "soundPlace": {
        "type": "string",
        "default": "block-place"
      },
      "soundBreak": {
        "type": "string",
        "default": "block-break"
      },
      "soundPaint": {
        "type": "string",
        "default": "paint"
      },
      "soundSign": {
        "type": "string",
        "default": "sign"
      },
      "soundFuse": {
        "type": "string",
        "default": "fuse"
      },
      "soundBoom": {
        "type": "string",
        "default": "boom"
      },
      "soundDenied": {
        "type": "string",
        "default": "denied"
      },
      "highlight": {
        "type": "string",
        "default": "#ffffff",
        "description": "Colour of the outline round the block under the cursor"
      }
    }
  },
