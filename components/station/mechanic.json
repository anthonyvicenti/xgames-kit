  "events": [
    {
      "name": "onComplete",
      "on": "host",
      "args": "{ station, player, quota: { done, needed, met } }",
      "when": "a task was finished"
    },
    {
      "name": "onStart",
      "on": "host",
      "args": "{ station, player }",
      "when": "a player began working a station"
    },
    {
      "name": "onCancel",
      "on": "host",
      "args": "{ station, player }",
      "when": "a player let go before it was done"
    }
  ],
  "host": {
    "owner": "host",
    "how": "the host owns each station's state and the quota; a copy sends its hold or taps",
    "state": "station",
    "fields": {
      "s": "[[state, workerSeat, progress %, cooldown × 10]] per station",
      "q": "[done, needed] the quota",
      "x": "screen text the rules set with station.show"
    }
  },
  "owns": [
    {
      "res": "input.interact",
      "shared": true,
      "why": "interact works a station in range (params.action)"
    }
  ],
  "needs": {
    "mechanics": [],
    "worlds": []
  },
  "uses": [],
  "gives": [
    "stations"
  ],
  "bots": "only when the rules send them with station.use(p, i, true)",
  "notes": {
    "lines": [
      "A station is a screen in the world (text and a bar the kit draws); hold, tap or stand in range works it, with the HUD's prompt.",
      "A finished task already scores pointsPerTask and counts toward quota; station.show(i, { title, lines, bar }) puts your own text on a screen.",
      "Place stations by zone, position or prop: params.stations is [{ zone }], [{ at: [x, y, z] }] or [{ prop, index }]."
    ],
    "readme": "components/station/README.md",
    "stub": {
      "as": "station",
      "worked": "station.onComplete(({ quota }) => { if (quota.met) ctx.round.end('quota met', ctx.players.list().map(p => p.id)); });",
      "traps": [
        "adding score in onComplete counts every task twice (pointsPerTask is already added): set pointsPerTask to 0 first",
        "bots work a station only when the rules send them: in bot(ctx, p) walk to it and call station.use(p, i, true)"
      ]
    }
  },
