{
  "id": "station",
  "name": "Station",
  "describe": "Interact with a prop: an in-world screen or panel UI, timed tasks, quotas",
  "examples": [
    "a desk with a job quota",
    "a PC the players use to complete orders",
    "a hold-to-fix control panel"
  ],
  "rank": 70,
  "params": {
    "type": "object",
    "additionalProperties": true,
    "properties": {
      "stations": {
        "type": "array",
        "default": [],
        "items": {
          "type": "object"
        },
        "description": "Where stations are: [{zone}] or [{at: [x, y, z]}] or [{prop: \"desk\", index: 0}] (the screen goes above that prop), each with an optional title. Empty: one in the middle of the play area"
      },
      "mode": {
        "type": "string",
        "enum": [
          "hold",
          "tap",
          "stand"
        ],
        "default": "hold",
        "description": "hold: hold the action for taskSeconds; tap: press it `taps` times; stand: stay in range"
      },
      "taskSeconds": {
        "type": "number",
        "description": "Seconds a hold or stand task takes",
        "minimum": 0.2,
        "maximum": 60,
        "default": 3
      },
      "taps": {
        "type": "integer",
        "minimum": 1,
        "maximum": 100,
        "default": 8,
        "description": "Presses a tap task takes"
      },
      "cooldown": {
        "type": "number",
        "description": "Seconds before a finished station can be worked again",
        "minimum": 0,
        "maximum": 120,
        "default": 2
      },
      "keepProgress": {
        "type": "boolean",
        "default": false,
        "description": "Letting go of a hold keeps the progress made (the same player resumes)"
      },
      "range": {
        "type": "number",
        "description": "How close a player must be (m)",
        "minimum": 0.5,
        "maximum": 8,
        "default": 2
      },
      "action": {
        "type": "string",
        "enum": [
          "interact",
          "primary",
          "secondary"
        ],
        "default": "interact",
        "description": "The input that works a station"
      },
      "quota": {
        "type": "integer",
        "minimum": 0,
        "maximum": 999,
        "default": 0,
        "description": "Tasks the whole team must finish (0: no quota); the rules read quota().met"
      },
      "quotaLabel": {
        "type": "string",
        "default": "Done",
        "description": "Word shown beside the quota count"
      },
      "title": {
        "type": "string",
        "default": "Station",
        "description": "Screen title"
      },
      "idleText": {
        "type": "string",
        "default": "Press E to start",
        "description": "Screen text while free"
      },
      "busyText": {
        "type": "string",
        "default": "In use by {name}",
        "description": "Screen text while someone else works it ({name})"
      },
      "mineText": {
        "type": "string",
        "default": "Working... {pct}%",
        "description": "Screen text while you work it ({pct})"
      },
      "doneText": {
        "type": "string",
        "default": "Done!",
        "description": "Screen text after a finished task"
      },
      "pointsPerTask": {
        "type": "number",
        "description": "Score the player gets for a finished task",
        "minimum": 0,
        "maximum": 100,
        "default": 1
      },
      "screenWidth": {
        "type": "number",
        "description": "Screen width (m)",
        "minimum": 0.3,
        "maximum": 5,
        "default": 1.4
      },
      "screenHeight": {
        "type": "number",
        "description": "Screen height (m)",
        "minimum": 0.2,
        "maximum": 3,
        "default": 0.7
      },
      "screenY": {
        "type": "number",
        "description": "Height of the screen centre above the ground (m)",
        "minimum": 0.3,
        "maximum": 5,
        "default": 1.9
      },
      "screenColor": {
        "type": "string",
        "default": "#12182b",
        "description": "Screen background"
      },
      "textColor": {
        "type": "string",
        "default": "#ffffff",
        "description": "Screen text colour"
      },
      "accent": {
        "type": "string",
        "default": "#4be0a8",
        "description": "Progress bar colour"
      },
      "standColor": {
        "type": "string",
        "default": "#8a93a8",
        "description": "Colour of the stand under a screen with no prop"
      },
      "stand": {
        "type": "boolean",
        "default": true,
        "description": "Draw a small stand under screens that are not on a prop"
      },
      "showPrompt": {
        "type": "boolean",
        "default": true,
        "description": "Show a hint near a station"
      },
      "soundStart": {
        "type": "string",
        "default": "",
        "description": "Sound id when work starts"
      },
      "soundDone": {
        "type": "string",
        "default": "coin",
        "description": "Sound id when a task is finished"
      }
    }
  },
