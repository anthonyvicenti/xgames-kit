{
  "id": "tag",
  "name": "Tag",
  "describe": "Roles that pass between players on contact, hide and seek",
  "examples": [
    "tag: whoever is it chases",
    "infection: tagged players join the chasers",
    "hide and seek with a head start"
  ],
  "rank": 90,
  "params": {
    "type": "object",
    "additionalProperties": true,
    "properties": {
      "its": {
        "type": "integer",
        "minimum": 1,
        "maximum": 4,
        "default": 1,
        "description": "Players who start as \"it\" (picked at random by the host)"
      },
      "mode": {
        "type": "string",
        "enum": [
          "swap",
          "infect"
        ],
        "default": "swap",
        "description": "swap: a tag passes the role on; infect: the tagged player becomes \"it\" too"
      },
      "radius": {
        "type": "number",
        "description": "Contact distance in metres",
        "minimum": 0.3,
        "maximum": 4,
        "default": 1
      },
      "cooldown": {
        "type": "number",
        "description": "Seconds before a tag can be tagged back, or the victim again",
        "minimum": 0,
        "maximum": 10,
        "default": 1.5
      },
      "hideSeconds": {
        "type": "number",
        "description": "Head start for the hiders: the \"it\"s are held still this long at the start (hide and seek)",
        "minimum": 0,
        "maximum": 60,
        "default": 0
      },
      "color": {
        "type": "string",
        "default": "#ff4d4d",
        "description": "Colour of the marker over the \"it\"s"
      },
      "prop": {
        "type": "string",
        "default": "",
        "description": "Prop slot hovering over the \"it\"s (\"\": a cone marker)"
      },
      "markerSize": {
        "type": "number",
        "description": "Marker size in metres",
        "minimum": 0.1,
        "maximum": 2,
        "default": 0.5
      },
      "toast": {
        "type": "boolean",
        "default": true,
        "description": "Show a line when someone becomes \"it\""
      },
      "toastText": {
        "type": "string",
        "default": "{name} is it!",
        "description": "That line; {name} is the new \"it\""
      },
      "soundTag": {
        "type": "string",
        "default": "bonk",
        "description": "Sound id when someone is tagged"
      },
      "knock": {
        "type": "number",
        "description": "Knock the victim gets from a tag (m/s, 0: none)",
        "minimum": 0,
        "maximum": 20,
        "default": 0
      }
