        "default": "player",
        "description": "Who owns paint: each player, or each team (the teams mechanic)"
      },
      "cell": {
        "type": "number",
        "description": "Preferred cell size in metres (cells grow so that there are at most maxCells)",
        "minimum": 0.25,
        "maximum": 6,
        "default": 1
      },
      "maxCells": {
        "type": "integer",
        "minimum": 16,
        "maximum": 900,
        "default": 400,
        "description": "Most cells in the grid (the whole grid travels in about 2 bytes a cell at worst)"
      },
      "radius": {
        "type": "number",
        "description": "Radius of a splat from a thrown shot (m)",
        "minimum": 0.2,
        "maximum": 8,
        "default": 1.3
      },
      "repaint": {
        "type": "boolean",
        "default": true,
        "description": "A later splat takes cells from the previous owner"
      },
