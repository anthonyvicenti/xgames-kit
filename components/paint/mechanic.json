        "type": "number",
        "description": "Paint opacity",
        "minimum": 0.1,
        "maximum": 1,
        "default": 0.85
      },
      "height": {
        "type": "number",
        "description": "Height above the ground the paint is drawn at (m)",
        "minimum": 0.005,
        "maximum": 0.2,
        "default": 0.03
      },
      "fromProjectile": {
        "type": "boolean",
        "default": true,
        "description": "Paint where the projectile mechanic's shots and streams touch the world"
      },
      "streamRadius": {
        "type": "number",
        "description": "Radius of a splat from a stream tick (m)",
        "minimum": 0.2,
        "maximum": 6,
        "default": 0.8
      },
      "walkRadius": {
        "type": "number",
        "description": "Paint under walking players with this radius (0: off, the ink-trail mode)",
        "minimum": 0,
        "maximum": 5,
        "default": 0
      },
      "walkInterval": {
        "type": "number",
        "description": "Seconds between trail splats",
        "minimum": 0.05,
        "maximum": 2,
        "default": 0.2
      },
      "zones": {
        "type": "array",
        "items": {
          "type": "string"
        },
