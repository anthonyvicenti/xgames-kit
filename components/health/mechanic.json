{
  "id": "health",
  "name": "Health",
  "describe": "Health, knockback, ragdoll and get-up, respawn",
  "examples": [
    "bonked: knocked over, gets up",
    "three hearts, respawn after 3 s",
    "water balloon hits"
  ],
  "rank": 40,
  "params": {
    "type": "object",
    "additionalProperties": true,
    "properties": {
      "hp": {
        "type": "number",
        "description": "Hit points (0: no meter, a hit only knocks the player over)",
        "minimum": 0,
        "maximum": 100,
        "default": 3
      },
      "regen": {
        "type": "number",
        "description": "Hit points regained per second once left alone",
        "minimum": 0,
        "maximum": 20,
        "default": 0
      },
      "regenDelay": {
        "type": "number",
        "description": "Seconds without a hit before regeneration starts",
        "minimum": 0,
        "maximum": 30,
        "default": 3
      },
      "ragdollOnHit": {
        "type": "boolean",
        "default": true,
        "description": "A hit with an impulse knocks the body over (ragdoll / knockdown animation)"
      },
      "getUpSeconds": {
        "type": "number",
        "description": "Seconds a knocked player stays down when fair play is off (with it on, fair.downSeconds rules)",
        "minimum": 0,
        "maximum": 8,
        "default": 1.5
      },
      "respawnSeconds": {
        "type": "number",
        "description": "Seconds a player at 0 hp stays out (0: never returns this round)",
        "minimum": 0,
        "maximum": 60,
        "default": 3
      },
      "respawnInvuln": {
        "type": "number",
        "description": "Seconds of protection after respawning",
        "minimum": 0,
        "maximum": 10,
        "default": 1.5
      },
      "respawnZone": {
        "type": "string",
        "default": "",
        "description": "World zone to respawn in (\"\": the player's own spawn point)"
      },
      "killY": {
        "type": "number",
        "description": "Falling below this height (m) counts as falling out of the world",
        "minimum": -200,
        "maximum": 0,
        "default": -8
      },
      "meter": {
        "type": "boolean",
        "default": true,
        "description": "Kept for old configs; the kit HUD always shows hit points when hp > 0 (CONTRACT §6g)"
      },
      "label": {
        "type": "string",
        "default": "Health",
        "description": "Meter label"
      },
      "color": {
        "type": "string",
        "default": "#ff5e6c",
        "description": "Meter colour"
      },
      "soundHurt": {
        "type": "string",
        "default": "",
        "description": "Sound id when someone loses hit points (\"\": none)"
      },
      "soundDown": {
        "type": "string",
        "default": "",
        "description": "Sound id when someone is knocked out (\"\": none)"
      }
    }
  },
