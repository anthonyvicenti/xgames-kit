{
  "id": "pickup",
  "name": "Pickup",
  "describe": "Consumables that refill or modify a player's meters; respawn",
  "examples": [
    "balls respawn",
    "health hearts around the arena",
    "coins to collect"
  ],
  "rank": 30,
  "params": {
    "type": "object",
    "additionalProperties": true,
    "properties": {
      "prop": {
        "type": "string",
        "default": "",
        "description": "Name of the prop.* slot to draw (\"\": the first gameplay prop of the game, else a coloured gem)"
      },
      "count": {
        "type": "integer",
        "minimum": -1,
        "maximum": 40,
        "default": -1,
        "description": "Spots placed at the start (-1: the game prop's count; 0: none, the rules call spawnAt)"
      },
      "zone": {
        "type": "string",
        "default": "",
        "description": "World zone the spots go in (\"\": scattered around the play area)"
      },
      "size": {
        "type": "number",
        "description": "Drawn size in metres",
        "minimum": 0.1,
        "maximum": 3,
        "default": 0.5
      },
      "color": {
        "type": "string",
        "default": "#ffd23f",
        "description": "Colour of the stand-in gem and the ring under it"
      },
      "effect": {
        "type": "string",
        "enum": [
          "auto",
          "carry",
          "heal",
          "score",
          "none"
        ],
        "default": "auto",
        "description": "What a touch does by itself: carry (hand the player a carried item), heal (health.heal), score (+value), none (rules only); auto: carry when the carry mechanic is there, else score"
      },
      "value": {
        "type": "number",
        "description": "Amount for heal and score",
        "minimum": 0,
        "maximum": 100,
        "default": 1
      },
      "radius": {
        "type": "number",
        "description": "Touch distance in metres",
        "minimum": 0.3,
        "maximum": 5,
        "default": 1
      },
      "collect": {
        "type": "string",
        "enum": [
          "touch",
          "press",
          "both"
        ],
        "default": "both",
        "description": "How a spot is taken: walking into it (touch), pressing `action` within `reach` (press), or either (both)"
      },
      "reach": {
        "type": "number",
        "description": "Press distance in metres (collect press or both)",
        "minimum": 0.5,
        "maximum": 6,
        "default": 2
      },
      "action": {
        "type": "string",
        "enum": [
          "interact",
          "primary",
          "secondary"
        ],
        "default": "interact",
        "description": "The input that takes a spot within reach"
      },
      "prompt": {
        "type": "boolean",
        "default": true,
        "description": "Show \"E: <controls.interact>\" when a spot is within reach"
      },
      "respawnSeconds": {
        "type": "number",
        "description": "Seconds until a taken spot returns (0: never)",
        "minimum": 0,
        "maximum": 120,
        "default": 8
      },
      "bob": {
        "type": "boolean",
        "default": true,
        "description": "Float up and down"
      },
      "spin": {
        "type": "boolean",
        "default": true,
        "description": "Turn slowly"
      },
      "maxSpots": {
        "type": "integer",
        "minimum": 1,
        "maximum": 40,
        "default": 24,
        "description": "Spots alive at once (each costs about 20 bytes of the world message)"
      },
      "soundCollect": {
        "type": "string",
        "default": "coin",
        "description": "Sound id when a spot is taken"
      },
      "marker": {
        "type": "string",
        "enum": [
          "auto",
          "ring",
          "none"
        ],
        "default": "auto",
        "description": "A faint ring on the ground under each spot. auto: only under the stand-in gem (a real prop model reads by itself); ring: always; none: never"
      }
    }
  },
