  "events": [
    {
      "name": "onCollect",
      "on": "host",
      "args": "{ player, index, effect, value, point, how: 'touch' | 'press' | 'rules' }",
      "when": "a player took a spot"
    }
  ],
  "host": {
    "owner": "host",
    "how": "the host owns the spots and who takes them; a guest's press goes to the host",
    "state": "pk",
    "fields": {
      "p": "[[x, y, z, state]] per spot: state 1 = out, 0 = taken and waiting to come back"
    }
  },
  "owns": [
    {
      "res": "input.interact",
      "shared": true,
      "why": "a press of interact within reach takes a spot (params.action, collect \"both\")"
    }
  ],
