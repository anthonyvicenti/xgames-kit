  "events": [
    {
      "name": "onHit",
      "on": "host",
      "args": "{ kind: 'discrete' | 'stream' | 'splash', shooter, target | null, point, dir, damage, counted, projectile }",
      "when": "a hit that counted (fair play let it through)"
    },
    {
      "name": "onBlocked",
      "on": "host",
      "args": "{ kind, shooter, target, why, projectile }",
      "when": "fair play refused a hit",
      "quiet": true
    },
    {
      "name": "onEnd",
      "on": "host",
      "args": "{ projectile: { id, tag, meta }, shooter, reason, point }",
      "when": "a shot ended (hit, wall, lifetime)",
      "quiet": true
    },
    {
      "name": "onSurface",
      "on": "host",
      "args": "{ kind: 'discrete' | 'stream', shooter, point, normal, projectile }",
      "when": "the world was hit (paint listens)",
      "quiet": true
    },
    {
      "name": "onFire",
      "on": "every copy",
      "args": "{ shooter, projectile, point }",
      "when": "a shot left a muzzle"
    }
  ],
