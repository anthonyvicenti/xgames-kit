{
  "id": "projectile",
  "name": "Projectile",
  "describe": "Discrete and continuous streams, arcs, hits, splash",
  "examples": [
    "dodgeball throw",
    "water-gun stream",
    "paint sprayer",
    "fire hose"
  ],
  "rank": 10,
  "params": {
    "type": "object",
    "additionalProperties": true,
    "properties": {
      "kind": {
        "type": "string",
        "enum": [
          "discrete",
          "continuous"
        ],
        "default": "discrete",
        "description": "discrete: one thrown shot per fire(); continuous: a held stream"
      },
      "prop": {
        "type": "string",
        "default": "",
        "description": "Name of a prop.* slot to draw each shot with (\"\" draws a coloured ball)"
      },
      "color": {
        "type": "string",
        "default": "#ff6a3d",
        "description": "Colour of the ball or the stream"
      },
      "size": {
        "type": "number",
        "description": "Shot radius in metres",
        "minimum": 0.05,
        "maximum": 1,
        "default": 0.22
      },
      "speed": {
        "type": "number",
        "description": "Launch speed in m/s (capped at 45)",
        "minimum": 2,
        "maximum": 45,
        "default": 18
      },
      "arc": {
        "type": "number",
        "description": "Upward bias of the launch direction: 0 flat, 0.25 a gentle lob",
        "minimum": 0,
        "maximum": 2,
        "default": 0.25
      },
      "gravity": {
        "type": "number",
        "description": "Gravity on a shot in m/s²",
        "minimum": 0,
        "maximum": 40,
        "default": 14
      },
      "lifetime": {
        "type": "number",
        "description": "Seconds before a shot gives up",
        "minimum": 0.5,
        "maximum": 10,
        "default": 3
      },
      "cooldown": {
        "type": "number",
        "description": "Seconds between one player's shots",
        "minimum": 0,
        "maximum": 5,
        "default": 0.45
      },
      "maxActive": {
        "type": "integer",
        "minimum": 1,
        "maximum": 20,
        "default": 12,
        "description": "Shots in flight at once (each costs about 45 bytes of the world message)"
      },
      "damage": {
        "type": "number",
        "description": "Damage a hit passes to the health mechanic and onHit",
        "minimum": 0,
        "maximum": 100,
        "default": 1
      },
      "knockback": {
        "type": "number",
        "description": "Horizontal knock a hit gives (m/s)",
        "minimum": 0,
        "maximum": 40,
        "default": 6
      },
      "knockUp": {
        "type": "number",
        "description": "Upward knock a hit gives (m/s)",
        "minimum": 0,
        "maximum": 20,
        "default": 3
      },
      "knockSeconds": {
        "type": "number",
        "description": "Seconds a knocked player is down",
        "minimum": 0,
        "maximum": 6,
        "default": 1.2
      },
      "splashRadius": {
        "type": "number",
        "description": "Splash radius in metres (0: none)",
        "minimum": 0,
        "maximum": 8,
        "default": 0
      },
      "splashKnockback": {
        "type": "number",
        "description": "Knock at the centre of a splash (m/s)",
        "minimum": 0,
        "maximum": 40,
        "default": 5
      },
      "friendlyFire": {
        "type": "boolean",
        "default": true,
        "description": "Whether teammates (the teams mechanic) can hit each other"
      },
      "selfHit": {
        "type": "boolean",
        "default": false,
        "description": "Whether a shot can hit its own shooter"
      },
      "bounces": {
        "type": "integer",
        "minimum": 0,
        "maximum": 6,
        "default": 0,
        "description": "Bounces off the world before a shot ends"
      },
      "bounceRestitution": {
        "type": "number",
        "description": "Speed kept after a bounce",
        "minimum": 0,
        "maximum": 1,
        "default": 0.6
      },
      "autoHealth": {
        "type": "boolean",
        "default": true,
        "description": "A hit calls health.damage when the health mechanic is present (else it knocks directly)"
      },
      "fireAnim": {
        "type": "string",
        "default": "aim",
        "description": "Animation word the shooter holds for a moment"
      },
      "soundFire": {
        "type": "string",
        "default": "throw",
        "description": "Sound id played at the muzzle"
      },
      "soundHit": {
        "type": "string",
        "default": "bonk",
        "description": "Sound id played where a shot hits"
      },
      "hitFx": {
        "type": "string",
        "description": "Name of a vfx preset (kit/vfx: spark-burst, impact-flash, smoke-puff, dust-kick, confetti, ...) drawn where a shot hits; unset: none. create copies the preset into config/game.json → vfx, where its colour, sprite and numbers are slots"
      },
      "streamSpeed": {
        "type": "number",
        "description": "Stream speed in m/s",
        "minimum": 3,
        "maximum": 40,
        "default": 14
      },
      "streamGravity": {
        "type": "number",
        "description": "Gravity on the stream (its arc)",
        "minimum": 0,
        "maximum": 30,
        "default": 9
      },
      "streamReach": {
        "type": "number",
        "description": "Longest stream in metres",
        "minimum": 1,
        "maximum": 30,
        "default": 9
      },
      "streamWidth": {
        "type": "number",
        "description": "Drop radius in metres",
        "minimum": 0.02,
        "maximum": 0.4,
        "default": 0.09
      },
      "streamRate": {
        "type": "number",
        "description": "Drops per second",
        "minimum": 5,
        "maximum": 90,
        "default": 36
      },
      "streamSpread": {
        "type": "number",
        "description": "Random spread of the aim",
        "minimum": 0,
        "maximum": 0.4,
        "default": 0.05
      },
      "streamDamage": {
        "type": "number",
        "description": "Damage per stream hit tick",
        "minimum": 0,
        "maximum": 100,
        "default": 0.5
      },
      "streamKnock": {
        "type": "number",
        "description": "Push per stream hit tick (m/s, never knocks over)",
        "minimum": 0,
        "maximum": 20,
        "default": 1.2
      },
      "streamHitInterval": {
        "type": "number",
        "description": "Seconds between stream hits on one target",
        "minimum": 0.05,
        "maximum": 2,
        "default": 0.2
      },
      "streamTank": {
        "type": "number",
        "description": "Seconds of spraying one tank holds (0: unlimited)",
        "minimum": 0,
        "maximum": 60,
        "default": 0
      },
      "streamRefill": {
        "type": "number",
        "description": "Tank refilled per second while not spraying (fraction)",
        "minimum": 0,
        "maximum": 5,
        "default": 0.4
      },
      "surfaceHz": {
        "type": "number",
        "description": "Surface hit callbacks per second while a stream touches the world",
        "minimum": 1,
        "maximum": 30,
        "default": 10
      },
      "bodyHeight": {
        "type": "number",
        "description": "Height of a player body for hit tests (m)",
        "minimum": 0.5,
        "maximum": 3,
        "default": 1.7
      },
      "muzzle": {
        "type": "string",
        "enum": [
          "chest",
          "hips"
        ],
        "default": "chest",
        "description": "Where shots and the stream leave the body: 'chest' (1.2 m up: a throw, a water gun, a hose) or 'hips' (the character's hip height, just ahead of the body: a pee stream)"
      }
    }
  },
