{
  "id": "levels",
  "name": "Levels",
  "describe": "A run of levels (one island or room set each): clear every enemy, the portal or door opens, everyone moves to the next; the last is the boss",
  "examples": [
    "three floating islands and a boss",
    "dungeon rooms you clear one by one",
    "a run of arenas with a portal between them"
  ],
  "rank": 120,
  "params": {
    "type": "object",
    "additionalProperties": true,
    "properties": {
      "count": {
        "type": "integer",
        "minimum": 1,
        "maximum": 8,
        "default": 3,
        "description": "Levels in a run (the world lays out one island or room set per level; CONTRACT §8)"
      },
      "wavesPerLevel": {
        "type": [
          "integer",
          "array"
        ],
        "default": 2,
        "description": "Waves on each level (a number, or one per level)"
      },
      "startCount": {
        "type": "integer",
        "minimum": 1,
        "maximum": 30,
        "default": 3,
        "description": "Enemies in a level's first wave on level 1"
      },
      "levelGrowth": {
        "type": "number",
        "description": "Extra enemies per wave on each later level",
        "minimum": 0,
        "maximum": 10,
        "default": 1
      },
      "growth": {
        "type": "number",
        "description": "Extra enemies in each later wave of a level",
        "minimum": 0,
        "maximum": 10,
        "default": 1
      },
      "countPerPlayer": {
        "type": "number",
        "description": "More enemies per player beyond the first (fraction)",
        "minimum": 0,
        "maximum": 2,
        "default": 0.35
      },
      "hpScale": {
        "type": "number",
        "description": "Enemy hit points gained per level (fraction)",
        "minimum": 0,
        "maximum": 2,
        "default": 0.15
      },
      "speedScale": {
        "type": "number",
        "description": "Enemy speed gained per level (fraction)",
        "minimum": 0,
        "maximum": 1,
        "default": 0.05
      },
      "bossLevel": {
        "type": "string",
        "enum": [
          "last",
          "none"
        ],
        "default": "last",
        "description": "last: the last level is the boss mechanic's fight"
      },
      "portalZone": {
        "type": "string",
        "default": "portal",
        "description": "The world zone of each level the portal stands in"
      },
      "portalSeconds": {
        "type": "number",
        "description": "Seconds the portal waits once one player is in it",
        "minimum": 1,
        "maximum": 60,
        "default": 8
      },
      "travelSeconds": {
        "type": "number",
        "description": "Seconds the move to the next level takes",
        "minimum": 0.2,
        "maximum": 5,
        "default": 0.8
      },
      "portalColor": {
        "type": "string",
        "default": "#7cf6ff",
        "description": "Colour of the portal's ring"
      },
      "portalGlow": {
        "type": "string",
        "default": "#b98cff",
        "description": "Colour of the portal's inner glow and its beam"
      },
      "portalProp": {
        "type": "string",
        "default": "portal",
        "description": "A prop.<name> model drawn as the portal when the game has it (else the kit's ring)"
      },
      "endRound": {
        "type": "boolean",
        "default": true,
        "description": "The run's end is the round's: won on the last level, lost when everyone is down at once"
      },
      "upgrades": {
        "type": "boolean",
        "default": true,
        "description": "Offer every player an upgrade card when a level is cleared (the loot mechanic)"
      },
      "chests": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4,
        "default": 1,
        "description": "Chests on each level (the loot mechanic)"
      },
      "bannerText": {
        "type": "string",
        "default": "Level {n}"
      },
      "bossText": {
        "type": "string",
        "default": "The final level"
      },
      "openText": {
        "type": "string",
        "default": "Portal open"
      },
      "winText": {
        "type": "string",
        "default": "Run cleared!"
      },
      "loseText": {
        "type": "string",
        "default": "Everyone is down"
      },
      "soundPortal": {
        "type": "string",
        "default": "portal-open"
      },
      "soundTravel": {
        "type": "string",
        "default": "portal-travel"
      }
    }
  },
