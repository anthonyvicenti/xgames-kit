{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xgames.fun/schemas/mechanic/1.json",
  "title": "Mechanic manifest (components/<id>/mechanic.json)",
  "description": "One behaviour: its params schema, slots, events, host ownership, the resources it claims (conflicts follow from two owners of one resource), its notes, its two-player fixture and an implementation per runtime that has it. A mechanic with one implementation may live inside that runtime and is only indexed here; no empty cross-runtime scaffold is written. Promoted from a delivered game's src/ after a second game needed it.",
  "type": "object",
  "required": [
    "id",
    "name",
    "describe",
    "examples",
    "params",
    "slots",
    "events",
    "host",
    "owns",
    "fixture",
    "impl",
    "state"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "https://xgames.fun/schemas/common/1.json#/$defs/id"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "describe": {
      "type": "string",
      "minLength": 1,
      "maxLength": 400
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "string",
        "maxLength": 80
      },
      "description": "The `as` lines a pitch may use."
    },
    "rank": {
      "type": "integer",
      "minimum": 0,
      "maximum": 999
    },
    "params": {
      "$ref": "https://xgames.fun/schemas/common/1.json#/$defs/jsonSchema",
      "description": "JSON Schema (2020-12) of spec.mechanics[].params, with defaults."
    },
    "slots": {
      "type": "object",
      "required": [
        "templates"
      ],
      "additionalProperties": false,
      "properties": {
        "templates": {
          "type": "array",
          "maxItems": 60,
          "items": {
            "$ref": "https://xgames.fun/schemas/common/1.json#/$defs/slotTemplate"
          }
        },
        "dynamic": {
          "type": "string",
          "maxLength": 300,
          "description": "When more slots follow from params (slotsFor): what they are."
        },
        "items": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "maxLength": 60
          },
          "description": "Item tables it keeps as JSON slots (melee's weapons, loot's upgrades)."
        }
      }
    },
    "events": {
      "type": "array",
      "maxItems": 20,
      "description": "The callbacks rules can hook and the kit's event log records; gate C (measure 38) looks for each one's answer on the screen of every player it names.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "on",
          "when"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^on[A-Z][a-zA-Z0-9]{0,31}$"
          },
          "on": {
            "enum": [
              "host",
              "every copy",
              "own copy"
            ]
          },
          "args": {
            "type": "string",
            "maxLength": 200
          },
          "when": {
            "type": "string",
            "maxLength": 200
          },
          "quiet": {
            "type": "boolean",
            "description": "Nothing on screen answers it by itself (a refused hit)."
          },
          "play": {
            "enum": ["score", "hit", "knockout", "pickup", "goal", "death", "combo", "move", "tag", "blast", "attempt"],
            "description": "What it is in play, for the play feed (kit/core/play.js, window.__game.play()): a meaningful kind of event, or an attempt (a shot, a throw, a swing). Without it the feed reads the event's name; a quiet event with none is not counted."
          }
        }
      }
    },
    "counters": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "maxLength": 80
      },
      "description": "Numbers it keeps per player that gate D accepts as the cause of a score change."
    },
    "host": {
      "type": "object",
      "required": [
        "owner"
      ],
      "additionalProperties": false,
      "description": "Who decides (host ownership): the host's copy owns shared state; a copy owns only what its own player does.",
      "properties": {
        "owner": {
          "enum": [
            "host",
            "copy",
            "none"
          ]
        },
        "how": {
          "type": "string",
          "maxLength": 400
        },
        "state": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z][a-zA-Z0-9]{0,15}$",
          "description": "Its key in snapshot().shared (null: keeps none)."
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "maxLength": 200
          },
          "description": "How to read each field of its shared state."
        }
      }
    },
    "owns": {
      "type": "array",
      "maxItems": 12,
      "description": "Resources it claims with default params (input.<action>, input.key.<code>, player.socket.<name>, player.control, round.end, hud.<x>). create refuses two owners of one resource unless every claim is shared. Claims that depend on params are said in when.",
      "items": {
        "type": "object",
        "required": [
          "res"
        ],
        "additionalProperties": false,
        "properties": {
          "res": {
            "type": "string",
            "pattern": "^(input\\.[a-zA-Z<>]+|input\\.key\\.[A-Za-z0-9]+|player\\.socket\\.[a-z_]+|player\\.control|round\\.end|hud\\.[a-z]+)$"
          },
          "shared": {
            "type": "boolean",
            "default": false
          },
          "when": {
            "type": "string",
            "maxLength": 200,
            "description": "The params that make the claim (left out: always)."
          },
          "why": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "needs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mechanics": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "https://xgames.fun/schemas/common/1.json#/$defs/id"
              },
              "when": {
                "type": "string",
                "maxLength": 200
              },
              "why": {
                "type": "string",
                "maxLength": 200
              }
            }
          }
        },
        "worlds": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 40
              },
              "why": {
                "type": "string",
                "maxLength": 200
              }
            }
          }
        }
      }
    },
    "uses": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "$ref": "https://xgames.fun/schemas/common/1.json#/$defs/id"
      },
      "description": "Mechanics it works with when present (never refused)."
    },
    "conflicts": {
      "type": "array",
      "maxItems": 12,
      "description": "Derived from owns at catalog time (two unshared claims on one resource with default params), never written by hand. Listed here only when a manifest needs to say more than owns does.",
      "items": {
        "type": "object",
        "required": [
          "with",
          "why"
        ],
        "additionalProperties": false,
        "properties": {
          "with": {
            "$ref": "https://xgames.fun/schemas/common/1.json#/$defs/id"
          },
          "why": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "bots": {
      "type": "string",
      "maxLength": 300,
      "description": "What bots do with it (by itself, or what the rules must call)."
    },
    "asks": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "about",
          "why"
        ],
        "additionalProperties": false,
        "properties": {
          "about": {
            "enum": [
              "body",
              "together"
            ]
          },
          "why": {
            "type": "string",
            "maxLength": 200
          }
        }
      },
      "description": "What a pitch must ask when the creator's words do not settle it."
    },
    "holds": {
      "type": "array",
      "maxItems": 4,
      "description": "When the player acts through this part all round and never as a walking body (a board played from the seats, a board of one's own), so friends are seen by the kit's presence part (gf/mp/presence.js): each entry's when is the params that make it so, its as what the player is: mark (a mark over one shared board: seats) or board (their own board: boards).",
      "items": {
        "type": "object",
        "required": [
          "when",
          "as"
        ],
        "additionalProperties": false,
        "properties": {
          "when": {
            "type": "object",
            "description": "params and the values that make it so (a param left out takes its default)"
          },
          "as": {
            "enum": [
              "mark",
              "board"
            ]
          },
          "why": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "objectives": {
      "type": "object",
      "required": ["props"],
      "additionalProperties": false,
      "description": "What its objectives() draw (the things a player must get to: pickups, carried items, gates, drops, a portal): each a param naming a prop.<name> slot of the game. The art step fills those slots by meaning (builder/art/objectives.mjs) and gate F (measure 14) holds them to it: never a stand-in, never a model that means something else.",
      "properties": {
        "props": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": ["param"],
            "additionalProperties": false,
            "properties": {
              "param": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9]{0,39}$", "description": "The param that names the prop." },
              "empty": { "enum": ["first-gameplay-prop", "none"], "default": "none", "description": "What the part draws when the param is empty: the game's first gameplay prop, or its own marker (no slot of the game)." }
            }
          }
        }
      }
    },
    "notes": {
      "type": "object",
      "additionalProperties": false,
      "description": "Read only by a build whose spec uses it.",
      "properties": {
        "lines": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string",
            "maxLength": 300
          }
        },
        "readme": {
          "type": "string",
          "maxLength": 200
        },
        "stub": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "as": {
              "type": "string",
              "maxLength": 40
            },
            "worked": {
              "type": "string",
              "maxLength": 300
            },
            "traps": {
              "type": "array",
              "maxItems": 6,
              "items": {
                "type": "string",
                "maxLength": 300
              }
            }
          }
        }
      }
    },
    "signs": {
      "type": "string",
      "maxLength": 300,
      "description": "Its sign of life for gate C (measure 15)."
    },
    "fixture": {
      "type": "object",
      "required": [
        "players"
      ],
      "additionalProperties": false,
      "description": "The two-player fixture both screens must pass (host and joiner over real WebRTC).",
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 200
        },
        "players": {
          "const": 2
        },
        "with": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "https://xgames.fun/schemas/common/1.json#/$defs/id"
          },
          "description": "Other mechanics the fixture spec uses."
        },
        "missing": {
          "type": "string",
          "maxLength": 300,
          "description": "When there is no fixture yet: what tests it instead (a gap)."
        }
      },
      "anyOf": [
        {
          "required": [
            "path"
          ]
        },
        {
          "required": [
            "missing"
          ]
        }
      ]
    },
    "impl": {
      "type": "object",
      "minProperties": 1,
      "description": "One entry per runtime that has an implementation, with its own state. A runtime missing here does not have it: a spec that needs it there writes it (a build promise).",
      "propertyNames": {
        "$ref": "https://xgames.fun/schemas/common/1.json#/$defs/id"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "path",
          "state"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 200
          },
          "profiles": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "$ref": "https://xgames.fun/schemas/common/1.json#/$defs/id"
            },
            "description": "The profiles it is proven on; left out, every profile of the runtime."
          },
          "state": {
            "$ref": "https://xgames.fun/schemas/common/1.json#/$defs/state"
          },
          "note": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "licence": {
      "$ref": "https://xgames.fun/schemas/common/1.json#/$defs/licence",
      "description": "When the code or an idea came from upstream: its licence and NOTICE."
    },
    "state": {
      "$ref": "https://xgames.fun/schemas/common/1.json#/$defs/state",
      "description": "The mechanic as a whole: open when any runtime has it open."
    },
    "capabilities": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "https://xgames.fun/schemas/common/1.json#/$defs/capability"
      },
      "description": "What it needs from the runtime profile (a voxel world, characters). The catalog offers it only where the profile has them."
    },
    "gives": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "https://xgames.fun/schemas/common/1.json#/$defs/capability"
      },
      "description": "Capabilities a game has when it uses this mechanic (projectiles, melee)."
    }
  }
}
