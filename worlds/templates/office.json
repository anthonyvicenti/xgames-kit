{
  "template": "office",
  "label": "Office",
  "kind": "indoor",
  "describe": "A closed office building on a city street: carpet tiles, a ceiling with hanging lamps, windows all round, an open-plan floor with an atrium in the middle, side rooms (break room, meeting room, lobby, manager's office, store room) joined by real doorways, and doors to the street.",
  "setPieces": [
    "the atrium: the open floor's middle is kept clear (zone centre), where the thing players defend or gather at stands",
    "a glass-walled meeting room (sightlines into it from the open floor)",
    "the doors to the street: the entrance (lobby or front wall) and a back door in the break room, where enemies and visitors come in (entries)"
  ],
  "sizes": { "small": [24, 24], "medium": [40, 32], "large": [48, 40] },
  "grid": 2,
  "shell": {
    "wall": "office-wall", "window": "office-wall-window", "door": "office-wall-doorway-wide", "corner": "office-wall-corner",
    "wallHeight": 2.579, "wallScale": [1, 1.3, 1], "windows": [1, 1, 0], "doorWidth": 1.71
  },
  "ceiling": {
    "height": 3.9, "lamp": "ceiling-lamp", "lampEvery": 6, "lampDrop": 0.69, "lampScale": 0.7,
    "look": { "color": "#f6f3ee", "color2": "#eeeae2", "glow": 0.4, "band": "#efe6da", "pattern": { "file": "assets/textures/ceiling-tiles.png", "size": 2.4 } }
  },
  "ground": { "kind": "floor", "color": "#93a7c9", "color2": "#8a9ec2", "outer": "#a9a59e", "outer2": "#a19d95", "outerSize": 200, "pattern": { "file": "assets/textures/carpet-tiles.png", "size": 2 } },
  "spawnRing": 3.2,
  "centreRadius": 1.4,
  "program": {
    "small": {
      "main": { "kind": "open-floor", "entry": "front" },
      "bands": [ { "side": "back", "depth": 6, "rooms": [ { "kind": "break", "weight": 1.2, "entry": "back" }, { "kind": "meeting", "weight": 1 } ] } ]
    },
    "medium": {
      "main": { "kind": "open-floor" },
      "loops": 1,
      "bands": [
        { "side": "left", "depth": 10, "order": "fixed", "rooms": [ { "kind": "manager", "weight": 0.9 }, { "kind": "meeting", "weight": 1 }, { "kind": "lobby", "weight": 1.1, "entry": "front" } ] },
        { "side": "back", "depth": 8, "rooms": [ { "kind": "break", "weight": 1.3, "entry": "back" }, { "kind": "storage", "weight": 0.9 } ] }
      ]
    },
    "large": {
      "main": { "kind": "open-floor" },
      "loops": 2,
      "bands": [
        { "side": "left", "depth": 10, "order": "fixed", "rooms": [ { "kind": "manager", "weight": 0.9 }, { "kind": "meeting", "weight": 1 }, { "kind": "lobby", "weight": 1.2, "entry": "front" } ] },
        { "side": "right", "depth": 10, "rooms": [ { "kind": "storage", "weight": 1, "entry": "side" }, { "kind": "meeting", "weight": 1 }, { "kind": "manager", "weight": 0.8 } ] },
        { "side": "back", "depth": 8, "rooms": [ { "kind": "break", "weight": 1.3, "entry": "back" }, { "kind": "lounge", "weight": 1 } ] }
      ]
    }
  },
  "rooms": {
    "open-floor": { "label": "Open floor", "keepClear": 4.5, "fill": [
