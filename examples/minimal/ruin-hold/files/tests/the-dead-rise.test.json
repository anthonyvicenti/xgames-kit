    { "do": "step", "seconds": 10 },
    { "do": "expect", "path": "rules.ai.director.phase", "op": "==", "value": "running", "why": "the wave director runs once the round starts" },
    { "do": "expect", "path": "rules.ai.enemies", "op": ">=", "value": 1, "why": "the dead have risen" },
